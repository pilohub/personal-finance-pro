<div class="main-container" style="max-width: 450px; margin: 80px auto;">
  
  <div class="glass-neu-card" style="padding: 40px 30px;">
    <h2 style="margin-bottom: 30px; font-weight: 300; color: #2c3e50; text-align: center;">Welcome Back</h2>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      
      <div style="margin-bottom: 20px; text-align: left;">
        <%= f.label :email, style: "color: #7f8c8d; font-size: 0.9rem; margin-bottom: 5px; display: block;" %><br />
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", style: "width: 100%; padding: 12px; border-radius: 10px; box-sizing: border-box;" %>
      </div>

      <div style="margin-bottom: 20px; text-align: left;">
        <%= f.label :password, style: "color: #7f8c8d; font-size: 0.9rem; margin-bottom: 5px; display: block;" %><br />
        <%= f.password_field :password, autocomplete: "current-password", class: "form-control", style: "width: 100%; padding: 12px; border-radius: 10px; box-sizing: border-box;" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div style="margin-bottom: 25px; text-align: left; display: flex; align-items: center; gap: 10px;">
          <%= f.check_box :remember_me, style: "width: 18px; height: 18px; cursor: pointer;" %>
          <%= f.label :remember_me, style: "color: #34495e; cursor: pointer; font-size: 0.95rem; margin: 0;" %>
        </div>
      <% end %>

      <div style="margin-bottom: 20px;">
        <%= f.submit "Log in", class: "btn-custom", style: "width: 100%; padding: 12px; font-size: 1.1rem;" %>
      </div>
    <% end %>

    <div style="margin-top: 25px; padding-top: 20px; border-top: 1px solid rgba(0,0,0,0.1);">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
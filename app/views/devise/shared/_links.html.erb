<div style="display: flex; flex-direction: column; gap: 12px; align-items: center; margin-top: 15px;">
  
  <%- if controller_name != 'sessions' %>
    <%= link_to "Log in", new_session_path(resource_name), class: "btn-custom", style: "width: 100%; text-decoration: none; text-align: center; box-sizing: border-box;" %>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <%= link_to "Sign up", new_registration_path(resource_name), class: "btn-custom", style: "width: 100%; text-decoration: none; text-align: center; box-sizing: border-box;" %>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <%= link_to "Forgot your password?", new_password_path(resource_name), style: "width: 100%; text-decoration: none; text-align: center; padding: 12px; border-radius: 10px; background: rgba(255,255,255,0.3); color: #2980b9; box-shadow: inset 3px 3px 6px rgba(163, 177, 198, 0.4), inset -3px -3px 6px rgba(255, 255, 255, 0.8); font-weight: 500; border: 1px solid rgba(255,255,255,0.5); box-sizing: border-box; transition: all 0.3s ease;" %>
  <% end %>

</div>
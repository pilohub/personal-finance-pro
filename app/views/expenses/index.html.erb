<div class="main-container" style="max-width: 1100px; width: 100%; margin: 0 auto; padding: 15px; box-sizing: border-box;">
  
<!-- 1. Top Header Section (FIXED LAYOUT & ANIMATIONS) -->
  <style>
    /* 3D Animations for PDF and Logout Buttons */
    .btn-pdf-3d {
      background: #e2e8f0;
      border: 1px solid rgba(255,255,255,0.4);
      border-radius: 8px;
      box-shadow: 4px 4px 10px rgba(0, 0, 0, 0.08), -4px -4px 10px rgba(255, 255, 255, 1);
      color: #334155;
      font-weight: 600;
      padding: 10px 20px;
      font-size: 14px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s ease;
    }
    .btn-pdf-3d:hover {
      transform: translateY(-2px);
      box-shadow: 6px 6px 12px rgba(0, 0, 0, 0.1), -6px -6px 12px rgba(255, 255, 255, 1);
    }
    .btn-pdf-3d:active {
      transform: translateY(2px);
      box-shadow: inset 3px 3px 6px rgba(0, 0, 0, 0.1), inset -3px -3px 6px rgba(255, 255, 255, 1);
    }

    .btn-logout-3d {
      background: #e74c3c;
      color: white;
      border: none;
      padding: 10px 20px;
      border-radius: 30px;
      cursor: pointer;
      box-shadow: 4px 4px 10px rgba(231, 76, 60, 0.3), -4px -4px 10px rgba(255, 255, 255, 0.8);
      transition: all 0.2s ease;
    }
    .btn-logout-3d:hover {
      transform: translateY(-2px);
      box-shadow: 6px 6px 12px rgba(231, 76, 60, 0.4), -6px -6px 12px rgba(255, 255, 255, 1);
    }
    .btn-logout-3d:active {
      transform: translateY(2px);
      box-shadow: inset 3px 3px 6px rgba(192, 57, 43, 0.5), inset -3px -3px 6px rgba(255, 120, 120, 0.5);
    }
  </style>

  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px; padding-bottom: 20px; border-bottom: 1px solid rgba(0,0,0,0.05); flex-wrap: wrap; gap: 20px;">
    
    <!-- Title & Streak (LEFT SIDE) -->
    <div style="display: flex; align-items: center; gap: 15px; flex-wrap: wrap;">
      <h1 style="margin: 0; font-weight: 300;">Personal Finance Pro</h1>
      
      <div style="background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%); padding: 6px 16px; border-radius: 20px; color: #d63031; font-weight: 600; font-size: 0.95rem; box-shadow: 3px 3px 10px rgba(255, 154, 158, 0.4), inset -2px -2px 5px rgba(255,255,255,0.8); border: 1px solid white; display: flex; align-items: center; gap: 5px;">
        <% if @streak > 0 %>
          🔥 <%= @streak %> Day Streak!
        <% else %>
          🧊 0 Day Streak
        <% end %>
      </div>
    </div>

    <!-- Action Buttons (RIGHT SIDE) -->
    <div style="display: flex; gap: 15px; align-items: center; flex-wrap: wrap; margin-left: auto;">
      
      <!-- 1. App Feature Buttons -->
     <!-- 3D PDF Download Button (Exactly like Excel Button) -->
<button id="download-pdf-btn" onclick="generatePDFReport()" class="btn-custom" style="margin: 0; color: #27ae60;">
  📄 Download PDF Report
</button>
      <%= link_to '📥 Download Excel', expenses_path(format: :csv), class: "btn-custom", style: "margin: 0; color: #27ae60;" %>
      <%= link_to '+ Add Transaction', new_expense_path, class: "btn-custom", style: "margin: 0;" %>

      <!-- Divider  -->
      <div style="width: 2px; height: 35px; background: rgba(0,0,0,0.08); margin: 0 5px; border-radius: 2px;"></div>

      <!-- 2. System Buttons  -->
      <button id="theme-toggle" class="btn-custom" style="margin: 0; cursor: pointer; border-radius: 50%; width: 45px; height: 45px; padding: 0; display: flex; justify-content: center; align-items: center; font-size: 1.2rem;">
        🌙
      </button>

      <!-- 3D Logout Button (Matched with Excel & PDF buttons) -->
      <%= button_to '🚪 Logout', destroy_user_session_path, method: :delete, class: "btn-custom", style: "margin: 0; background: #fee2e2; color: #dc2626; border: none;" %>
    </div>
  </div>
  <!-- Header Section Ends Here -->

  <!-- 2. KPI Metric Cards (Budget, Expenses, Balance) -->
  <div class="dashboard-grid" style="display: flex; flex-wrap: wrap; gap: 20px; margin-bottom: 30px;">
    <!-- Budget Card with Update Form -->
    <div class="glass-neu-card" style="flex: 1; min-width: 250px; box-sizing: border-box;">
      <p class="kpi-title">Monthly Budget</p>
      <p class="kpi-value">₹<%= @monthly_budget %></p>
      
      <%= form_with url: set_budget_expenses_path, method: :post, local: true do |f| %>
        <div style="display: flex; gap: 10px; margin-top: 15px; justify-content: center; align-items: center;">
          <%= f.number_field :budget, value: @monthly_budget, class: "form-control", style: "width: 120px; padding: 8px; text-align: center; border-radius: 8px;", placeholder: "New Budget" %>
          <%= f.submit "Update", class: "btn-custom", style: "margin-bottom: 0; padding: 8px 15px; border-radius: 8px; font-size: 0.9rem;" %>
        </div>
      <% end %>
    </div>

    <!-- Total Expenses Card -->
    <div class="glass-neu-card" style="flex: 1; min-width: 250px; box-sizing: border-box;">
      <p class="kpi-title">Total Expenses</p>
      <p class="kpi-value danger">₹<%= @total_expense %></p>
    </div>
    
    <!-- Current Balance Card -->
    <div class="glass-neu-card" style="flex: 1; min-width: 250px; box-sizing: border-box;">
      <p class="kpi-title">Current Balance</p>
      <p class="kpi-value success">₹<%= @balance %></p>
    </div>
  </div>

  <!-- ROW 1: Analytics & Budget Tracking (Graphs) -->
  <div class="analytics-section" style="display: flex; gap: 20px; margin-bottom: 30px; flex-wrap: wrap;">
    <!-- Pie Chart Card -->
    <div class="glass-neu-card" style="flex: 1; min-width: 300px; box-sizing: border-box;">
      <p class="kpi-title">Expenses by Category</p>
      <div class="chart-container" style="position: relative; height: 250px;">
        <canvas id="categoryChart"></canvas>
      </div>
    </div>

    <!-- Budget Progress Card -->
    <div class="glass-neu-card" style="flex: 1; min-width: 300px; box-sizing: border-box;">
      <p class="kpi-title">Budget Utilization</p>
      <div class="budget-section" style="margin-top: 40px;">
        <h4 style="color: #34495e; font-weight: 400;">Total Limit Used</h4>
        <div class="progress-track" style="background: rgba(0,0,0,0.05); height: 15px; border-radius: 10px; overflow: hidden; margin-top: 10px;">
          <% percentage = (@monthly_budget > 0) ? ((@total_expense.to_f / @monthly_budget) * 100).round(2) : 0 %>
          <div class="progress-fill" style="height: 100%; width: <%= percentage > 100 ? 100 : percentage %>%; background: <%= percentage > 80 ? '#e74c3c' : 'linear-gradient(90deg, #3498db, #2ecc71)' %>; transition: width 0.5s ease;"></div>
        </div>
        <p style="text-align: right; font-size: 0.85rem; color: #7f8c8d; margin-top: 5px;"><%= percentage %>% Used</p>
      </div>
    </div>
  </div>


  <!-- 🎯 Dream Savings Goal Tracker -->
  <div class="glass-neu-card" style="margin-bottom: 30px; width: 100%; box-sizing: border-box; background: rgba(255, 255, 255, 0.4); backdrop-filter: blur(12px); box-shadow: 8px 8px 16px rgba(0,0,0,0.05), -8px -8px 16px rgba(255,255,255,0.8); border: 1px solid rgba(255,255,255,0.5); border-radius: 20px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
      <p class="kpi-title" style="color: #2980b9; font-weight: 500; margin: 0;">🎯 Dream Savings Goal</p>
      <button onclick="document.getElementById('goal-form').style.display='block'" class="btn-custom" style="margin: 0; padding: 5px 15px; font-size: 0.85rem;">+ Update Goal</button>
    </div>

    <!-- Hidden Update Form -->
    <div id="goal-form" style="display: none; margin-bottom: 25px; padding: 15px; background: rgba(255,255,255,0.6); border-radius: 12px; border: 1px solid rgba(255,255,255,0.8);">
      <%= form_with url: update_goal_expenses_path, method: :post, local: true, style: "display: flex; gap: 10px; flex-wrap: wrap; align-items: center;" do |f| %>
        <%= f.text_field :title, value: @goal.title, placeholder: "Goal Name (e.g. iPhone)", class: "form-control", style: "padding: 8px; flex: 1; min-width: 150px;" %>
        <%= f.number_field :target_amount, value: @goal.target_amount, placeholder: "Target ₹", class: "form-control", style: "padding: 8px; width: 120px;" %>
        <%= f.number_field :current_amount, value: @goal.current_amount, placeholder: "Saved ₹", class: "form-control", style: "padding: 8px; width: 120px;" %>
        
        <%= f.submit "Save", class: "btn-custom", style: "margin: 0; padding: 8px 15px; background: #27ae60; color: white;" %>
        <button type="button" onclick="document.getElementById('goal-form').style.display='none'" class="btn-custom" style="margin: 0; padding: 8px 15px; background: #e74c3c; color: white;">Cancel</button>
      <% end %>
    </div>
    
    <div style="display: flex; flex-wrap: wrap; gap: 20px; align-items: center;">
      <!-- Dynamic Info -->
      <div style="flex: 1; min-width: 200px;">
        <h3 style="font-weight: 300; color: #2c3e50; margin: 0 0 5px 0;"><%= @goal.title %></h3>
        <p style="font-size: 0.9rem; color: #7f8c8d; margin: 0;">Target: ₹<%= @goal.target_amount %></p>
      </div>

      <!-- Dynamic Progress Bar -->
      <div style="flex: 3; min-width: 250px;">
        <% goal_percentage = (@goal.target_amount > 0) ? ((@goal.current_amount / @goal.target_amount) * 100).round(1) : 0 %>
        <% goal_percentage = 100 if goal_percentage > 100 %>
        
        <div style="display: flex; justify-content: space-between; font-size: 0.85rem; color: #34495e; margin-bottom: 8px;">
          <span>Saved: ₹<%= @goal.current_amount %></span>
          <span><%= goal_percentage %>%</span>
        </div>
        <div style="height: 12px; background: #e0e5ec; border-radius: 10px; box-shadow: inset 3px 3px 6px rgba(163,177,198,0.5), inset -3px -3px 6px rgba(255,255,255,0.9); overflow: hidden;">
          <div style="height: 100%; width: <%= goal_percentage %>%; background: linear-gradient(90deg, #3498db, #2ecc71); border-radius: 10px; transition: width 0.5s ease;"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- 🔄 Subscription & EMI Tracker -->
  <div class="glass-neu-card" style="margin-bottom: 30px; width: 100%; box-sizing: border-box; background: rgba(255, 255, 255, 0.4); backdrop-filter: blur(12px); box-shadow: 8px 8px 16px rgba(0,0,0,0.05), -8px -8px 16px rgba(255,255,255,0.8); border: 1px solid rgba(255,255,255,0.5); border-radius: 20px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; flex-wrap: wrap; gap: 10px;">
      <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
        <p class="kpi-title" style="color: #e67e22; font-weight: 500; margin: 0;">🔄 Monthly Subscriptions & EMIs</p>
        <span style="background: rgba(230, 126, 34, 0.1); color: #d35400; padding: 4px 10px; border-radius: 12px; font-size: 0.8rem; font-weight: 600;">Total: ₹<%= @total_subscription_amount %> / month</span>
      </div>
      <button onclick="document.getElementById('subscription-form').style.display='block'" class="btn-custom" style="margin: 0; padding: 5px 15px; font-size: 0.85rem;">+ Add Fixed Expense</button>
    </div>

    <!-- Hidden Add Subscription Form -->
    <div id="subscription-form" style="display: none; margin-bottom: 20px; padding: 15px; background: rgba(255,255,255,0.6); border-radius: 12px; border: 1px solid rgba(255,255,255,0.8);">
      <%= form_with url: add_subscription_expenses_path, method: :post, local: true, style: "display: flex; gap: 10px; flex-wrap: wrap; align-items: center;" do |f| %>
        <%= f.text_field :name, placeholder: "Service Name (e.g. Netflix, Bike EMI)", class: "form-control", style: "padding: 8px; flex: 1; min-width: 150px;", required: true %>
        <%= f.number_field :amount, placeholder: "Amount ₹", class: "form-control", style: "padding: 8px; width: 120px;", required: true %>
        <%= f.number_field :due_day, placeholder: "Due Date (1-31)", class: "form-control", style: "padding: 8px; width: 120px;", min: 1, max: 31, required: true %>
        
        <%= f.submit "Save", class: "btn-custom", style: "margin: 0; padding: 8px 15px; background: #27ae60; color: white;" %>
        <button type="button" onclick="document.getElementById('subscription-form').style.display='none'" class="btn-custom" style="margin: 0; padding: 8px 15px; background: #e74c3c; color: white;">Cancel</button>
      <% end %>
    </div>

    <!-- Subscriptions List -->
    <div style="display: flex; gap: 15px; flex-wrap: wrap; margin-top: 15px;">
      <% if @subscriptions.any? %>
        <% @subscriptions.each do |sub| %>
          <div style="background: white; padding: 12px 20px; border-radius: 12px; box-shadow: 3px 3px 8px rgba(0,0,0,0.03); border: 1px solid rgba(0,0,0,0.05); display: flex; flex-direction: column; gap: 5px; min-width: 120px;">
            <strong style="color: #2c3e50; font-size: 0.95rem;"><%= sub.name %></strong>
            <span style="color: #e74c3c; font-weight: 500; font-size: 1.1rem;">₹<%= sub.amount %></span>
            <span style="color: #7f8c8d; font-size: 0.8rem;">Every <%= sub.due_day.ordinalize %></span>
          </div>
        <% end %>
      <% else %>
        <p style="color: #7f8c8d; font-size: 0.9rem; margin: 0; font-style: italic;">No fixed expenses added yet. Add one to track your monthly commitments!</p>
      <% end %>
    </div>
  </div>

  <!-- 👯 Advanced Split Bill (Exact Division) -->
  <div class="glass-neu-card" style="margin-bottom: 30px; width: 100%; box-sizing: border-box; background: rgba(255, 255, 255, 0.4); backdrop-filter: blur(12px); box-shadow: 8px 8px 16px rgba(0,0,0,0.05), -8px -8px 16px rgba(255,255,255,0.8); border: 1px solid rgba(255,255,255,0.5); border-radius: 20px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
      <p class="kpi-title" style="color: #27ae60; font-weight: 500; margin: 0;">👯 Split with Friends</p>
      <span style="font-size: 0.85rem; color: #7f8c8d; background: rgba(0,0,0,0.05); padding: 4px 10px; border-radius: 12px;">Bill Breakdown 🍕</span>
    </div>

    <div style="display: flex; flex-wrap: wrap; gap: 20px;">
      <!-- Input Section -->
      <div style="flex: 1; min-width: 250px; display: flex; flex-direction: column; gap: 15px;">
        <div>
          <label style="font-size: 0.85rem; color: #34495e; font-weight: 500;">Total Bill Amount (₹)</label>
          <input type="number" id="split-amount" placeholder="e.g. 50" class="form-control" style="padding: 10px; border-radius: 10px; width: 100%; box-sizing: border-box; margin-top: 5px;">
        </div>
        <div>
          <label style="font-size: 0.85rem; color: #34495e; font-weight: 500;">All Names (Comma separated)</label>
          <input type="text" id="split-names" placeholder="e.g. Me, Milan, Romil..." class="form-control" style="padding: 10px; border-radius: 10px; width: 100%; box-sizing: border-box; margin-top: 5px;">
          <small style="color: #95a5a6; font-size: 0.75rem;">* Enter exactly how many people are sharing.</small>
        </div>
        <button onclick="calculateDetailedSplit()" class="btn-custom" style="margin: 0; background: linear-gradient(135deg, #2ecc71, #27ae60); color: white; width: 100%; padding: 12px; font-weight: 600; border-radius: 10px;">
          Calculate Split ✨
        </button>
      </div>

      <!-- Result Section -->
      <div style="flex: 1; min-width: 250px; background: rgba(255, 255, 255, 0.6); padding: 20px; border-radius: 15px; border: 1px solid rgba(46, 204, 113, 0.2); min-height: 150px;">
        <h4 style="margin: 0 0 15px 0; color: #2c3e50; font-weight: 400; border-bottom: 1px solid rgba(0,0,0,0.05); padding-bottom: 10px;">Calculation Details</h4>
        <div id="split-result-list">
          <p style="color: #7f8c8d; font-size: 0.9rem; font-style: italic; text-align: center; margin-top: 30px;">Enter amount and names to see the breakdown!</p>
        </div>
      </div>
    </div>
  </div>

  <!-- 🧾 Smart Receipt Scanner (With Image Preview) -->
  <div class="glass-neu-card" style="margin-bottom: 30px; width: 100%; box-sizing: border-box; background: rgba(255, 255, 255, 0.4); backdrop-filter: blur(12px); box-shadow: 8px 8px 16px rgba(0,0,0,0.05), -8px -8px 16px rgba(255,255,255,0.8); border: 1px solid rgba(255,255,255,0.5); border-radius: 20px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
      <p class="kpi-title" style="color: #8e44ad; font-weight: 500; margin: 0;">🧾 AI Receipt Scanner</p>
      <span style="font-size: 0.85rem; color: #7f8c8d; background: rgba(0,0,0,0.05); padding: 4px 10px; border-radius: 12px;">Auto-detect Bill Amount 📸</span>
    </div>

    <div style="display: flex; flex-wrap: wrap; gap: 20px; align-items: stretch;">
      <!-- Upload Section -->
      <div style="flex: 1; min-width: 250px; display: flex; flex-direction: column; justify-content: center; align-items: center;">
        <button onclick="document.getElementById('receipt-upload').click()" type="button" style="border: 2px dashed #bdc3c7; border-radius: 15px; padding: 20px; text-align: center; cursor: pointer; background: rgba(255,255,255,0.5); width: 100%; transition: all 0.3s ease;">
          <div style="font-size: 2rem; margin-bottom: 10px;">📷</div>
          <p style="margin: 0; color: #34495e; font-weight: 500;">Click to Upload Bill</p>
        </button>
        <input type="file" id="receipt-upload" accept="image/*" style="display: none;">
        <img id="image-preview" style="display: none; max-width: 100%; max-height: 150px; margin-top: 15px; border-radius: 10px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); border: 1px solid rgba(142,68,173,0.3);" />
      </div>

      <!-- Result Section -->
      <div style="flex: 1; min-width: 250px; background: rgba(255, 255, 255, 0.6); padding: 20px; border-radius: 15px; border: 1px solid rgba(142, 68, 173, 0.2); display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 150px;">
        <!-- Loading Spinner -->
        <div id="scan-loading" style="display: none; flex-direction: column; align-items: center;">
          <div style="border: 4px solid #f3f3f3; border-top: 4px solid #8e44ad; border-radius: 50%; width: 40px; height: 40px; animation: spin 1s linear infinite; margin-bottom: 15px; border-radius: 50%;"></div>
          <p style="color: #8e44ad; font-weight: 500; margin: 0; text-align: center;">AI is reading the bill...<br><small style="color: #7f8c8d; font-size: 0.75rem;">(First time takes 10-15 seconds)</small></p>
        </div>

        <!-- Result Display -->
        <div id="scan-result" style="text-align: center;">
          <p style="margin: 0 0 10px 0; color: #7f8c8d; font-size: 0.95rem;">Detected Amount</p>
          <h3 id="detected-amount" style="color: #8e44ad; font-size: 3rem; margin: 0; font-weight: 300;">₹ 0</h3>
        </div>
      </div>
    </div>
  </div>

  <!-- ROW 2: 🚀 Future Wealth Simulator Section -->
  <div class="glass-neu-card" style="margin-bottom: 30px; width: 100%; box-sizing: border-box;">
    <p class="kpi-title" style="color: #8e44ad; font-weight: 500;">🚀 Future Wealth Simulator (5 Years)</p>
    
    <div style="display: flex; flex-wrap: wrap; gap: 20px; align-items: center; margin-top: 15px;">
      <div style="flex: 2; min-width: 250px;">
        <p style="font-size: 0.95rem; color: #7f8c8d; line-height: 1.5;">
          If you invest your current monthly balance <strong>(₹<%= @balance %>)</strong> every month 
          systematically (SIP) with a <strong>12% expected return</strong>, how much wealth will you have generated after 5 years?
        </p>
        <button onclick="calculateWealth(<%= @balance %>)" class="btn-custom" style="margin-top: 15px; background: linear-gradient(135deg, #8e44ad, #3498db); color: white; border: none;">
          Calculate Magic ✨
        </button>
      </div>

      <div style="flex: 1; min-width: 200px; background: rgba(142, 68, 173, 0.05); padding: 25px; border-radius: 15px; text-align: center; border: 1px solid rgba(142, 68, 173, 0.2);">
        <h3 id="wealth-result" style="color: #8e44ad; margin: 0; font-size: 2.2rem; font-weight: 300;">₹ ?</h3>
        <p style="font-size: 0.85rem; color: #9b59b6; margin-top: 8px; font-weight: 500;">Expected Value</p>
      </div>
    </div>
  </div>

  <!-- ROW 3: Transaction History Table -->
  <div class="glass-neu-card" style="padding: 20px 25px; width: 100%; box-sizing: border-box;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
      <h3 style="font-weight: 300; color: #2c3e50; margin: 0;">Recent Transactions</h3>
    </div>

    <!-- Filter Form -->
    <div style="margin-bottom: 25px; padding: 15px; background: rgba(255, 255, 255, 0.3); border-radius: 12px; border: 1px solid rgba(255,255,255,0.5);">
      <%= form_with url: expenses_path, method: :get, local: true, style: "display: flex; gap: 15px; align-items: center; flex-wrap: wrap;" do |f| %>
        <strong style="color: #34495e;">🔍 Filter:</strong>
        <%= f.select :category, options_for_select(Expense.pluck(:category).uniq.reject(&:blank?), params[:category]), { include_blank: "All Categories" }, class: "form-control", style: "width: 200px; padding: 8px;" %>
        <%= f.month_field :month, value: params[:month], class: "form-control", style: "width: 180px; padding: 8px;" %>
        <%= f.submit "Search", class: "btn-custom", style: "margin: 0; padding: 8px 20px; font-size: 0.9rem;" %>
        <%= link_to "Clear", expenses_path, class: "btn-custom", style: "margin: 0; padding: 8px 20px; font-size: 0.9rem; background: #e74c3c; color: white; box-shadow: 3px 3px 6px rgba(231, 76, 60, 0.4);" %>
      <% end %>
    </div>

    <div style="overflow-x: auto;">
      <table style="width: 100%; border-collapse: collapse;">
        <thead>
          <tr>
            <th style="text-align: left; padding: 12px; border-bottom: 1px solid rgba(0,0,0,0.1);">Title</th>
            <th style="text-align: left; padding: 12px; border-bottom: 1px solid rgba(0,0,0,0.1);">Category</th>
            <th style="text-align: left; padding: 12px; border-bottom: 1px solid rgba(0,0,0,0.1);">Date</th>
            <th style="text-align: center; padding: 12px; border-bottom: 1px solid rgba(0,0,0,0.1);">Guilt</th>
            <th style="text-align: right; padding: 12px; border-bottom: 1px solid rgba(0,0,0,0.1);">Amount</th>
            <th style="text-align: center; padding: 12px; border-bottom: 1px solid rgba(0,0,0,0.1);">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @expenses.each do |expense| %>
            <tr>
              <td style="padding: 12px; font-weight: 500; border-bottom: 1px solid rgba(0,0,0,0.05);"><%= expense.title %></td>
              <td style="padding: 12px; border-bottom: 1px solid rgba(0,0,0,0.05);"><span style="background: rgba(52, 152, 219, 0.1); color: #2980b9; padding: 5px 10px; border-radius: 15px; font-size: 0.8rem;"><%= expense.category %></span></td>
              <td style="padding: 12px; color: #7f8c8d; border-bottom: 1px solid rgba(0,0,0,0.05);"><%= expense.date.strftime("%d %b, %Y") if expense.date %></td>
              <td style="padding: 12px; text-align: center; border-bottom: 1px solid rgba(0,0,0,0.05);">
                <% score = expense.necessity || 1 %> 
                <span style="font-size: 0.8rem; padding: 4px 8px; border-radius: 10px; background: <%= score > 3 ? 'rgba(231, 76, 60, 0.1)' : 'rgba(46, 204, 113, 0.1)' %>; color: <%= score > 3 ? '#e74c3c' : '#27ae60' %>;">
                  <%= "🔥" * score %>
                </span>
              </td>
              <td class="amount" style="padding: 12px; text-align: right; border-bottom: 1px solid rgba(0,0,0,0.05);">₹<%= expense.amount %></td>
              <td class="action-links" style="padding: 12px; text-align: center; border-bottom: 1px solid rgba(0,0,0,0.05);">
                <%= link_to 'Edit', edit_expense_path(expense), style: "color: #3498db; text-decoration: none; font-size: 0.9rem;" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- 📄 THE ULTIMATE HIDDEN PDF REPORT TEMPLATE -->
  <div id="pdf-wrapper" style="display: none; position: absolute; top: -9999px; left: -9999px; width: 800px; background: #ffffff;">
    <div id="hidden-pdf-report" style="width: 100%; padding: 40px; background: #ffffff; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; box-sizing: border-box; color: #333;">
      
      <!-- Report Header -->
      <div style="text-align: center; border-bottom: 3px solid #8e44ad; padding-bottom: 20px; margin-bottom: 30px;">
        <h1 style="margin: 0; color: #2c3e50; font-size: 26px; font-weight: bold; text-transform: uppercase;">Comprehensive Finance Report</h1>
        <p style="margin: 5px 0 0 0; color: #7f8c8d; font-size: 14px;">Personal Finance Pro | Generated on: <%= Date.today.strftime("%d %b, %Y") %></p>
      </div>

      <% 
        current_budget = 50000.0 
        total_exp = @expenses.sum(:amount) 
        balance = current_budget - total_exp
        used_percentage = current_budget > 0 ? ((total_exp / current_budget) * 100).round(1) : 0
        
        monthly_rate = 0.12 / 12
        months = 60
        sip_projected = 0
        if balance > 0
          sip_projected = (balance * (((1 + monthly_rate)**months - 1) / monthly_rate) * (1 + monthly_rate)).round(2)
        end
      %>

      <!-- KPI Summary -->
      <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
        <div style="background: #f8f9fa; padding: 15px; border-radius: 8px; width: 31%; border: 1px solid #e9ecef; text-align: center;">
          <p style="margin: 0; color: #7f8c8d; font-size: 11px; text-transform: uppercase; font-weight: bold;">Monthly Budget</p>
          <h3 style="margin: 5px 0 0 0; color: #2980b9; font-size: 20px;">₹ <%= current_budget %></h3>
        </div>
        <div style="background: #f8f9fa; padding: 15px; border-radius: 8px; width: 31%; border: 1px solid #e9ecef; text-align: center;">
          <p style="margin: 0; color: #7f8c8d; font-size: 11px; text-transform: uppercase; font-weight: bold;">Total Expenses</p>
          <h3 style="margin: 5px 0 0 0; color: #e74c3c; font-size: 20px;">₹ <%= total_exp %></h3>
        </div>
        <div style="background: #f8f9fa; padding: 15px; border-radius: 8px; width: 31%; border: 1px solid #e9ecef; text-align: center;">
          <p style="margin: 0; color: #7f8c8d; font-size: 11px; text-transform: uppercase; font-weight: bold;">Available Balance</p>
          <h3 style="margin: 5px 0 0 0; color: #27ae60; font-size: 20px;">₹ <%= balance %></h3>
        </div>
      </div>

      <!-- Budget Utilization Progress -->
      <div style="margin-bottom: 30px; background: #fff; padding: 15px; border: 1px solid #bdc3c7; border-radius: 8px;">
        <p style="margin: 0 0 10px 0; font-size: 14px; color: #2c3e50; font-weight: bold;">Budget Utilization: <span style="color: <%= used_percentage > 80 ? '#e74c3c' : '#27ae60' %>"><%= used_percentage %>% Used</span></p>
        <div style="width: 100%; background: #ecf0f1; border-radius: 10px; height: 12px; overflow: hidden;">
          <div style="width: <%= used_percentage > 100 ? 100 : used_percentage %>%; background: <%= used_percentage > 80 ? '#e74c3c' : '#27ae60' %>; height: 100%;"></div>
        </div>
      </div>

      <!-- Active Subscriptions & EMIs -->
      <h3 style="color: #2c3e50; margin-bottom: 10px; font-size: 16px; border-bottom: 1px solid #eee; padding-bottom: 5px;">Active Subscriptions & EMIs</h3>
      <% if @subscriptions && @subscriptions.any? %>
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13px; margin-bottom: 30px; table-layout: fixed;">
          <thead>
            <tr style="background: #f4f6f7; color: #2c3e50;">
              <th style="padding: 10px; border: 1px solid #bdc3c7; width: 50%;">Service Name</th>
              <th style="padding: 10px; border: 1px solid #bdc3c7; width: 25%;">Due Day</th>
              <th style="padding: 10px; border: 1px solid #bdc3c7; width: 25%;">Amount</th>
            </tr>
          </thead>
          <tbody>
            <% @subscriptions.each do |sub| %>
              <tr>
                <td style="padding: 8px; border: 1px solid #ecf0f1;"><%= sub.name %></td>
                <td style="padding: 8px; border: 1px solid #ecf0f1;">Every <%= sub.due_day %>th</td>
                <td style="padding: 8px; border: 1px solid #ecf0f1; color: #c0392b;">₹ <%= sub.amount %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p style="font-size: 13px; color: #7f8c8d; margin-bottom: 30px;">No active subscriptions or EMIs found.</p>
      <% end %>

      <!-- Future Wealth Simulator (SIP) -->
      <div style="margin-bottom: 30px; background: rgba(142, 68, 173, 0.05); padding: 15px; border-left: 4px solid #8e44ad; border-radius: 4px;">
        <h3 style="margin: 0 0 8px 0; color: #8e44ad; font-size: 15px;">🚀 Future Wealth Simulator (5 Years)</h3>
        <% if balance > 0 %>
          <p style="margin: 0; font-size: 13px; color: #34495e; line-height: 1.5;">
            If you invest your current monthly balance of <strong>₹<%= balance %></strong> every month (SIP) with a 12% expected return, your projected wealth after 5 years will be: 
            <strong style="font-size: 18px; color: #27ae60; display: block; margin-top: 5px;">₹ <%= sip_projected.to_s.reverse.gsub(/(\d{3})(?=\d)/, '\\1,').reverse %></strong>
          </p>
        <% else %>
          <p style="margin: 0; font-size: 13px; color: #e74c3c;">Save some money to see your future wealth projection!</p>
        <% end %>
      </div>

      <!-- Transaction History -->
      <h3 style="color: #2c3e50; margin-bottom: 10px; font-size: 16px; border-bottom: 1px solid #eee; padding-bottom: 5px;">Detailed Transaction History</h3>
      <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13px; table-layout: fixed;">
        <thead>
          <tr style="background: #2c3e50; color: white;">
            <th style="padding: 10px; border: 1px solid #bdc3c7; width: 20%;">Date</th>
            <th style="padding: 10px; border: 1px solid #bdc3c7; width: 40%;">Title</th>
            <th style="padding: 10px; border: 1px solid #bdc3c7; width: 25%;">Category</th>
            <th style="padding: 10px; border: 1px solid #bdc3c7; width: 15%;">Amount</th>
          </tr>
        </thead>
        <tbody>
          <% if @expenses.any? %>
            <% @expenses.each do |expense| %>
              <tr style="border-bottom: 1px solid #ecf0f1; background: #fff;">
                <td style="padding: 8px; border: 1px solid #ecf0f1;"><%= expense.date.strftime("%d %b, %Y") if expense.date %></td>
                <td style="padding: 8px; border: 1px solid #ecf0f1; word-wrap: break-word;"><%= expense.title %></td>
                <td style="padding: 8px; border: 1px solid #ecf0f1;"><%= expense.category %></td>
                <td style="padding: 8px; border: 1px solid #ecf0f1; color: #e74c3c; font-weight: bold;">₹<%= expense.amount %></td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="4" style="padding: 15px; text-align: center; color: #7f8c8d;">No transactions found.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
      
      <!-- Footer -->
      <div style="margin-top: 40px; text-align: center; color: #95a5a6; font-size: 11px; border-top: 1px solid #eee; padding-top: 15px;">
        <p>This is a computer-generated report. App created for College Project Submission.</p>
      </div>
    </div>
  </div>

</div> <!-- Main Container Properly Closed Here -->

<!-- ALL SCRIPT TAGS (No changes here) -->

<style>
  @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
</style>

<script>
  // PDF Report Logic
  function generatePDFReport() {
    const wrapper = document.getElementById('pdf-wrapper');
    const element = document.getElementById('hidden-pdf-report');
    const downloadBtn = document.getElementById('download-pdf-btn');
    
    wrapper.style.display = 'block';
    downloadBtn.innerHTML = '⏳ Generating HD Report...';

    const opt = {
      margin:       [10, 10, 10, 10], 
      filename:     'Complete_Finance_Report.pdf',
      image:        { type: 'jpeg', quality: 1.0 },
      html2canvas:  { scale: 2, useCORS: true, letterRendering: true },
      jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' }
    };

    html2pdf().set(opt).from(element).save().then(() => {
      wrapper.style.display = 'none';
      downloadBtn.innerHTML = '📄 Download PDF Report';
    });
  }

  // Advanced Split Calculation Logic
  function calculateDetailedSplit() {
    const amountInput = document.getElementById('split-amount').value;
    const namesInput = document.getElementById('split-names').value;
    const resultContainer = document.getElementById('split-result-list');
    const amount = parseFloat(amountInput);
    
    if (!amount || amount <= 0) {
      resultContainer.innerHTML = "<p style='color:#e74c3c; text-align:center;'>⚠️ Please enter a valid bill amount.</p>";
      return;
    }

    const friends = namesInput.split(',').map(name => name.trim()).filter(name => name.length > 0);
    
    if (friends.length === 0) {
      resultContainer.innerHTML = "<p style='color:#e74c3c; text-align:center;'>⚠️ Please enter at least one name.</p>";
      return;
    }

    const totalPeople = friends.length; 
    const perPerson = (amount / totalPeople).toFixed(2);

    let html = `<div style="display: flex; justify-content: space-between; margin-bottom: 15px; background: rgba(46,204,113,0.1); padding: 10px; border-radius: 8px;">
                  <span style="color: #27ae60; font-weight: 600;">Per Person Share:</span>
                  <span style="color: #27ae60; font-weight: 600;">₹${perPerson}</span>
                </div>`;
                
    html += `<ul style="list-style: none; padding: 0; margin: 0; font-size: 0.95rem;">`;
    friends.forEach(friend => {
      html += `<li style="padding: 10px 0; border-bottom: 1px dashed rgba(0,0,0,0.1); display: flex; justify-content: space-between; align-items: center;">
                  <span>👤 <strong>${friend}</strong> pays:</span>
                  <span style="color: #e74c3c; font-weight: bold; background: rgba(231,76,60,0.1); padding: 4px 10px; border-radius: 12px;">₹${perPerson}</span>
               </li>`;
    });
    html += `</ul>`;

    resultContainer.innerHTML = html;
  }

  // Smart Receipt Scanner Logic
  document.addEventListener("turbo:load", function() {
    const fileInput = document.getElementById('receipt-upload');
    if (fileInput) {
      fileInput.addEventListener('change', function(event) {
        const file = event.target.files[0];
        if (!file) return;

        const previewImg = document.getElementById('image-preview');
        previewImg.src = URL.createObjectURL(file);
        previewImg.style.display = 'block';

        const loadingDiv = document.getElementById('scan-loading');
        const resultDiv = document.getElementById('scan-result');
        const amountDisplay = document.getElementById('detected-amount');

        resultDiv.style.display = 'none';
        loadingDiv.style.display = 'flex';

        Tesseract.recognize(
          file,
          'eng',
          { logger: m => console.log(m.status + ": " + Math.round(m.progress * 100) + "%") }
        ).then(({ data: { text } }) => {
          loadingDiv.style.display = 'none';
          resultDiv.style.display = 'block';

          let cleanText = text.replace(/,/g, ''); 
          let lines = cleanText.split('\n');
          let finalAmount = 0;
          let possibleTotals = [];

          lines.forEach(line => {
            if (line.toLowerCase().includes('total')) {
              let nums = line.match(/\b\d+(\.\d{1,2})?\b/g);
              if (nums) {
                nums.forEach(n => possibleTotals.push(parseFloat(n)));
              }
            }
          });

          if (possibleTotals.length > 0) {
            finalAmount = Math.max(...possibleTotals);
          } else {
            let allNums = cleanText.match(/\b\d+(\.\d{1,2})?\b/g);
            if (allNums) {
              let validNums = allNums.map(Number).filter(n => n < 50000);
              if (validNums.length > 0) {
                finalAmount = Math.max(...validNums);
              }
            }
          }

          if (finalAmount > 0) {
            amountDisplay.innerText = "₹ " + finalAmount.toFixed(2);
            amountDisplay.style.transform = "scale(1.15)";
            amountDisplay.style.transition = "transform 0.3s ease";
            setTimeout(() => { amountDisplay.style.transform = "scale(1)"; }, 300);
          } else {
            amountDisplay.innerText = "₹ 0";
            alert("Sorry, no valid bill amount found.");
          }
        }).catch(err => {
          console.error(err);
          loadingDiv.style.display = 'none';
          resultDiv.style.display = 'block';
          amountDisplay.innerText = "Error";
        });
        
        fileInput.value = ""; 
      });
    }
  });

  // Dark Mode Toggle Logic
  document.addEventListener("turbo:load", function() {
    const themeToggleBtn = document.getElementById("theme-toggle");
    const body = document.body;
    
    if (localStorage.getItem("theme") === "dark") {
      body.classList.add("dark-mode");
      themeToggleBtn.textContent = "☀️"; 
    }

    if (themeToggleBtn) {
      themeToggleBtn.addEventListener("click", function() {
        body.classList.toggle("dark-mode");
        if (body.classList.contains("dark-mode")) {
          localStorage.setItem("theme", "dark");
          themeToggleBtn.textContent = "☀️";
        } else {
          localStorage.setItem("theme", "light");
          themeToggleBtn.textContent = "🌙";
        }
      });
    }
  });

  // Wealth Simulator Logic
  function calculateWealth(monthlyInvestment) {
    const resultElement = document.getElementById('wealth-result');
    
    if (monthlyInvestment <= 0) {
      resultElement.innerText = "₹0";
      resultElement.style.color = "#e74c3c";
      return;
    }

    const ratePerMonth = 0.12 / 12; 
    const months = 5 * 12; 
    const futureValue = monthlyInvestment * ((Math.pow(1 + ratePerMonth, months) - 1) / ratePerMonth) * (1 + ratePerMonth);
    
    resultElement.innerText = "₹" + Math.round(futureValue).toLocaleString('en-IN');
    resultElement.style.transform = "scale(1.1)";
    resultElement.style.transition = "transform 0.3s ease";
    setTimeout(() => {
      resultElement.style.transform = "scale(1)";
    }, 300);
  }

  // Chart.js Logic
  document.addEventListener("turbo:load", function() {
    let existingChart = Chart.getChart("categoryChart"); 
    if (existingChart != undefined) {
      existingChart.destroy();
    }

    const canvas = document.getElementById('categoryChart');
    if (canvas) {
      const ctx = canvas.getContext('2d');
      const rawData = <%= raw @category_data.to_json %>;
      const labels = Object.keys(rawData);
      const data = Object.values(rawData);

      new Chart(ctx, {
        type: 'doughnut',
        data: {
          labels: labels,
          datasets: [{
            data: data,
            backgroundColor: ['#3498db', '#e74c3c', '#f1c40f', '#2ecc71', '#9b59b6', '#34495e'],
            borderWidth: 0,
            hoverOffset: 4
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'right' }
          }
        }
      });
    }
  });
</script>